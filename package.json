{
  "name": "city-boardgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:data": "node --experimental-strip-types --no-warnings scripts/generate-boards.ts",
    "import:design": "node --experimental-strip-types --no-warnings scripts/import-design.ts",
    "accept": "vite build && node --experimental-strip-types --no-warnings e2e/accept.ts",
    "icons:preview": "node --experimental-strip-types --no-warnings scripts/icon-preview.ts",
    "tuner": "vite --config tools/tuner/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
